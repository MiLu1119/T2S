# mock: no model/key; local: vLLM; external: hosted OpenAI-compatible API
LLM_PROVIDER=mock
LLM_MODEL=qwen2.5-coder-7b
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MAX_TOKENS=1024
LLM_API_KEY=EMPTY

# ETC requires token logprobs. Unsupported providers automatically fall back.
LLM_ENABLE_ETC=false
ETC_FIRST_DIFF_THRESHOLD=0.12
ETC_SECOND_DIFF_THRESHOLD=0.08
ETC_WINDOW=3

AGENT_MAX_RETRIES=3
SQL_TIMEOUT_SEC=5
# Runtime risk signals. Confidence is a heuristic warning score, not a calibrated probability.
CONFIDENCE_WARNING_THRESHOLD=0.65
# EXPLAIN always runs after AST validation. Enforcement is opt-in for backward compatibility.
SQL_COST_ENFORCE=false
SQL_COST_MAX_ESTIMATED_COST=100000
SQL_COST_MAX_ESTIMATED_ROWS=1000000
SQL_COST_MAX_FULL_SCANS=3
LLM_REQUEST_TIMEOUT_SEC=60

# Required before binding the service to 0.0.0.0.
WEB_USERNAME=verisql
WEB_PASSWORD=replace-with-a-long-random-password
# Production must set independent random secrets; WEB_PASSWORD fallback is only
# retained for backward-compatible local startup.
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_SOURCE_MASTER_KEY=replace-with-an-independent-random-key
# During key rotation only: set the previous key(s), start once to re-encrypt,
# then remove this variable after verification.
DATA_SOURCE_OLD_MASTER_KEYS=
IDENTITY_DB_PATH=identity.sqlite
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
# Comma-separated server directories from which users may register SQLite files.
SQLITE_ALLOWED_ROOTS=/srv/verisql/databases
SQLITE_UPLOAD_DIR=data/uploads
SQLITE_UPLOAD_MAX_MB=100

# sqlite keeps the bundled demo. postgresql requires DATABASE_URL.
DATABASE_BACKEND=sqlite
# Base directory for relative identity/audit/checkpoint/workbench paths.
VERISQL_RUNTIME_DIR=.
DATABASE_URL=postgresql://text2sql_reader:password@127.0.0.1:5432/business_db
DATABASE_SCHEMAS=public
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SEC=5
DB_POOL_MAX_LIFETIME_SEC=1800
DB_MAX_ROWS=1000

# full is the historical baseline; rag enables initial hybrid Schema retrieval.
SCHEMA_CONTEXT_MODE=full
SCHEMA_RAG_TOP_TABLES=3
SCHEMA_RAG_TOP_COLUMNS=8
SCHEMA_RAG_VALUE_SAMPLES=5
SCHEMA_CATALOG_DB_PATH=schema_catalog.sqlite
SCHEMA_EMBEDDING_ENABLED=false
SCHEMA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SCHEMA_EMBEDDING_CACHE_DIR=models/fastembed
SCHEMA_EMBEDDING_WEIGHT=0.45

# Structured audit is stored separately from the business database.
AUDIT_ENABLED=true
AUDIT_DB_PATH=audit.sqlite
AUDIT_RETENTION_DAYS=30
AUDIT_STORE_QUESTION=true

# LangGraph persistence: none | sqlite | redis | redis-stack.
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_SQLITE_PATH=checkpoints.sqlite
SESSION_HISTORY_TURNS=5
WORKBENCH_DB_PATH=workbench.sqlite
WORKBENCH_RESULT_TTL_MINUTES=1440
# Redis TTL is expressed in minutes. redis works with ordinary Redis;
# redis-stack selects the official Search/JSON-based saver.
CHECKPOINT_TTL_MINUTES=1440
REDIS_URL=redis://127.0.0.1:6379/0

# OpenTelemetry tracing. Use console for local verification or otlp for Langfuse.
TRACING_ENABLED=false
TRACING_EXPORTER=none
OTEL_SERVICE_NAME=verisql-agent
OTEL_ENVIRONMENT=development
OTEL_SAMPLE_RATIO=1.0
# Langfuse example (set credentials outside source control):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20BASE64_PUBLIC_KEY_COLON_SECRET_KEY
