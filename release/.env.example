WEB_PORT=8080
WEB_USERNAME=superadmin
WEB_PASSWORD=CHANGE_ME_LOGIN_PASSWORD
SESSION_SECRET=CHANGE_ME_RANDOM_SESSION_SECRET_AT_LEAST_32_CHARS
DATA_SOURCE_MASTER_KEY=CHANGE_ME_INDEPENDENT_RANDOM_MASTER_KEY
# Only during credential-key rotation; remove after one successful migration restart.
DATA_SOURCE_OLD_MASTER_KEYS=
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false

REDIS_PASSWORD=CHANGE_ME_URL_SAFE_REDIS_PASSWORD
CHECKPOINT_TTL_MINUTES=1440
SESSION_HISTORY_TURNS=5
WORKBENCH_DB_PATH=/app/runtime/workbench.sqlite
WORKBENCH_RESULT_TTL_MINUTES=1440

LLM_PROVIDER=external
LLM_MODEL=YOUR_MODEL_NAME
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=YOUR_API_KEY
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
LLM_REQUEST_TIMEOUT_SEC=60
LLM_ENABLE_ETC=false
ETC_FIRST_DIFF_THRESHOLD=0.12
ETC_SECOND_DIFF_THRESHOLD=0.08
ETC_WINDOW=3

AGENT_MAX_RETRIES=3
SQL_TIMEOUT_SEC=5
DB_MAX_ROWS=1000
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SEC=5
DB_POOL_MAX_LIFETIME_SEC=1800
SQLITE_UPLOAD_MAX_MB=100

SCHEMA_CONTEXT_MODE=rag
SCHEMA_RAG_TOP_TABLES=4
SCHEMA_RAG_TOP_COLUMNS=12
SCHEMA_RAG_VALUE_SAMPLES=5
SCHEMA_CATALOG_DB_PATH=/app/runtime/schema_catalog.sqlite
SCHEMA_EMBEDDING_ENABLED=true
SCHEMA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SCHEMA_EMBEDDING_CACHE_DIR=/app/models/fastembed
SCHEMA_EMBEDDING_WEIGHT=0.45

AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=30
AUDIT_STORE_QUESTION=true

TRACING_ENABLED=true
TRACING_EXPORTER=console
OTEL_SERVICE_NAME=verisql-agent
OTEL_ENVIRONMENT=production
OTEL_SAMPLE_RATIO=1.0
